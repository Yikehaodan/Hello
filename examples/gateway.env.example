# Copy into the configuration directory shown in Hello → Settings → Services.
# DeepSeek official defaults. Other HTTPS Chat Completions services are supported.
# Supply your own key. Do not commit real credentials.
HELLO_LLM_BASE_URL=https://api.deepseek.com
HELLO_LLM_API_KEY=replace-with-your-api-key
HELLO_LLM_MODEL=deepseek-flash
